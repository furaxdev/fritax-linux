#!/bin/sh
# ============================================================
#  Fritax Linux : ecran de connexion puis bureau.
#  Le trio login -> bureau -> retour au login forme un vrai
#  gestionnaire de session : on se connecte, on travaille, on
#  se deconnecte, et l'ecran de connexion revient.
#
#  Securite de demarrage : si l'ecran de connexion n'arrive pas
#  a prendre l'affichage (carte graphique deja occupee, pilote
#  absent, plantage), on ne boucle pas pour rien — au bout de
#  trois essais rates, le bureau demarre directement. Sans ca,
#  le relancer en boucle reprenait l'ecran toutes les 2 secondes
#  et empechait tout autre programme de s'afficher.
# ============================================================
case "$1" in
  start)
    printf "Fritax Linux : ecran de connexion...\n"
    if [ ! -e /dev/dri/card0 ]; then
      printf "  (pas de carte graphique DRM : connexion ignoree)\n"
      exit 0
    fi
    (
      echecs=0
      while true; do
        /usr/bin/fritax-login >>/var/log/fritax-login.log 2>&1
        code=$?
        [ -e /tmp/fritax-stop ] && break

        if [ "$code" -ne 0 ]; then
          echecs=$((echecs + 1))
        else
          echecs=0
        fi

        if [ "$echecs" -ge 3 ]; then
          printf "  (l'ecran de connexion n'arrive pas a prendre l'affichage : demarrage direct du bureau)\n" >>/var/log/fritax-login.log
          printf "  (bureau lance sans ecran de connexion, voir /var/log/fritax-shell.log)\n"
          rate=0
          while [ "$rate" -lt 3 ]; do
            /usr/bin/fritax-shell >>/var/log/fritax-shell.log 2>&1
            [ -e /tmp/fritax-stop ] && break 2
            rate=$((rate + 1))
            printf "  (bureau arrete, nouvelle tentative %d sur 3)\n" "$rate" >>/var/log/fritax-shell.log
            sleep 2
          done
          # Trois echecs d'affilee : on laisse la console en texte plutot que de
          # relancer sans fin une session qui ne peut pas s'afficher.
          printf "  (affichage indisponible : console laissee en texte)\n" >>/var/log/fritax-login.log
          printf "Fritax Linux : l'affichage est occupe, la console reste utilisable.\n"
          printf "Journaux : /var/log/fritax-login.log et /var/log/fritax-shell.log\n"
          break
        fi

        printf "  (session terminee, retour a l'ecran de connexion)\n" >>/var/log/fritax-login.log
        sleep 2
      done
    ) &
    ;;
  stop)
    touch /tmp/fritax-stop
    killall fritax-login 2>/dev/null || true
    killall fritax-shell 2>/dev/null || true
    rm -f /tmp/fritax-stop
    ;;
  restart|reload)
    "$0" stop; sleep 1; "$0" start
    ;;
esac
exit 0
