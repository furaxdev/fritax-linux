# Fritax Linux - configuration du noyau (extrait)
# Affichage direct (DRM/KMS) : pas de serveur graphique du tout
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Vieux GPU AMD (le Acer de Fritax) + cartes de test dans une machine virtuelle
CONFIG_DRM_RADEON=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_SIMPLEDRM=y
# Souris et clavier directs (evdev)
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
# Systemes de fichiers (ISO live + disque + squashfs compresse)
CONFIG_ISO9660_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
# Reseau (utile pour installer des choses plus tard)
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y
